# SilverOps Environment Configuration

# Anthropic API Key (for the live agent loop in /api/agent)
# Set NEXT_PUBLIC_DEMO_MODE=live to enable live model execution.
# Voice-note preview and phonetic guides need no keys — they run entirely
# client-side via the browser's Web Speech / Web Audio APIs.
ANTHROPIC_API_KEY=
NEXT_PUBLIC_DEMO_MODE=demo
