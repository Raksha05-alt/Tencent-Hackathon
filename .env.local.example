# SilverOps Environment Configuration

# 1. Anthropic API Key (for Live Agent Loop in /api/agent)
# Set NEXT_PUBLIC_DEMO_MODE=live to enable live model execution
ANTHROPIC_API_KEY=
NEXT_PUBLIC_DEMO_MODE=demo

# 2. Text-To-Speech (TTS) Neural Voice API Keys (Optional)
# If provided, /api/tts uses OpenAI or ElevenLabs for high-fidelity speech.
# Otherwise, the app defaults to zero-config browser Web Speech & Web Audio synthesis.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
